<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
        table, th, td{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Username</th>
            <th>Edit Username</th>
            <th>Delete User</th>
        </tr>
        <% for (user of users) {%>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.username %></td>
            <td>
                <form method="get" action="/user/<%= user.id %>/edit">
                    <button>Edit Username</button>
                </form>
            </td>
            <td>
                <form method="get" action="/user/<%= user.id %>/delete">
                    <button>Detete User</button>
                </form>
            </td>
        </tr>
        <% } %>
    </table>

    <form method="get" action="/user/newuser">
        <button>Add New User</button>
    </form>
    
</body>
</html>